<?xml version="1.0" encoding="utf-8"?>
<!-- Card ⋮ menu: frosted glass panel (popups can't blur, so it uses the solid glass tint) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="4dp"
    android:insetTop="4dp">
    <shape>
        <corners android:radius="18dp" />
        <solid android:color="@color/glass_panel_solid" />
        <stroke
            android:width="1dp"
            android:color="@color/glass_stroke" />
        <padding
            android:bottom="6dp"
            android:top="6dp" />
    </shape>
</inset>
