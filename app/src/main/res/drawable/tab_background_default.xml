<?xml version="1.0" encoding="utf-8"?>
<!-- Unselected tab: surface pill with a thin purple → pink gradient outline.
     Same 3dp inset as the selected tab, so tabs keep their size when switching. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape>
            <corners android:radius="21dp" />
            <gradient
                android:angle="0"
                android:endColor="#99FF4F9A"
                android:startColor="#997C4DFF" />
        </shape>
    </item>
    <item
        android:bottom="4.5dp"
        android:left="4.5dp"
        android:right="4.5dp"
        android:top="4.5dp">
        <shape>
            <corners android:radius="19.5dp" />
            <solid android:color="@color/surface" />
        </shape>
    </item>
</layer-list>
