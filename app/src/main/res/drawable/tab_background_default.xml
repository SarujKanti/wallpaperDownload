<?xml version="1.0" encoding="utf-8"?>
<!-- Unselected tab: clean capsule with a soft lavender outline.
     Same 3dp inset as the selected tab, so tabs keep their size when switching. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="3dp">
    <shape>
        <corners android:radius="23dp" />
        <solid android:color="@color/tab_surface" />
        <stroke
            android:width="1dp"
            android:color="@color/tab_stroke" />
    </shape>
</inset>
