<?xml version="1.0" encoding="utf-8"?>
<!-- Glass search bar with a purple → pink gradient border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="30dp" />
            <gradient
                android:angle="0"
                android:endColor="#CCFF4F9A"
                android:startColor="#99FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape>
            <corners android:radius="29dp" />
            <solid android:color="#B3181830" />
        </shape>
    </item>
</layer-list>
