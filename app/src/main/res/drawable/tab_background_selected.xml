<?xml version="1.0" encoding="utf-8"?>
<!-- Selected tab: glossy purple → pink capsule with a soft glow ring and a glass sheen on top -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow ring -->
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="0"
                android:endColor="#40FF4F9A"
                android:startColor="#407C4DFF" />
        </shape>
    </item>
    <!-- Capsule -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape>
            <corners android:radius="23dp" />
            <gradient
                android:angle="0"
                android:centerColor="#B44CE0"
                android:endColor="@color/accent_pink"
                android:startColor="@color/accent_purple" />
        </shape>
    </item>
    <!-- Glass sheen: light on the top half, fading out -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape>
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
