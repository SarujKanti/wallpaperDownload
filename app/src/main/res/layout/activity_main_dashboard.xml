<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The header (photo, title, headline, search) is 25% of the screen and scrolls away with
         the grid; the tabs then stay pinned at the top, just below the status bar. -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <!-- Header photo (follows the selected tab), runs under the status bar.
                 Height is set to 25% of the screen in code. -->
            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

    
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_gradient_splash"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Wallora.HeroBottom" />
    
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim" />
    
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/heroContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">
    
                    <!-- Top bar -->
                    <ImageView
                        android:id="@+id/ivMore"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_glass_button"
                        android:contentDescription="@string/cd_menu"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="11dp"
                        android:src="@drawable/ic_menu"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />
    
                    <ImageView
                        android:id="@+id/ivLiked"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_white_button"
                        android:contentDescription="@string/lbl_menu_liked"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="11dp"
                        android:src="@drawable/ic_heart"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/like_red" />
    
                    <LinearLayout
                        android:id="@+id/titleBlock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@id/ivMore"
                        app:layout_constraintEnd_toStartOf="@id/ivLiked"
                        app:layout_constraintStart_toEndOf="@id/ivMore"
                        app:layout_constraintTop_toTopOf="@id/ivMore">
    
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
    
                            <TextView
                                android:id="@+id/tvTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/lbl_git_repo"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold" />
    
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="1dp"
                                android:importantForAccessibility="no"
                                android:rotation="20"
                                android:text="👑"
                                android:textSize="12sp"
                                android:translationY="-7dp" />
                        </LinearLayout>
    
                        <TextView
                            android:id="@+id/tvSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:maxLines="1"
                            android:text="@string/lbl_tagline"
                            android:textColor="#E6FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
    
                    <!-- Bottom of the top bar: the taller of the buttons and the title block
                         (the title grows with the user's font size) -->
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/topBarBottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="ivMore,titleBlock,ivLiked" />
    
                    <!-- Headline shrinks to fit the space left between the top bar and the search -->
                    <TextView
                        android:id="@+id/tvHeadline"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:lineSpacingMultiplier="0.95"
                        android:maxLines="2"
                        android:text="@string/lbl_headline"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="18sp"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintBottom_toTopOf="@id/searchBar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/topBarBottom" />
    
                    <!-- Search -->
                    <LinearLayout
                        android:id="@+id/searchBar"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_search_glass"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
    
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_search"
                            app:tint="@color/white" />
    
                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:ellipsize="end"
                            android:hint="@string/lbl_search_hint"
                            android:imeOptions="actionSearch"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textColorHint="#B3FFFFFF"
                            android:textSize="12sp" />
    
                        <ImageView
                            android:id="@+id/btnSearch"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_search_button"
                            android:contentDescription="@string/lbl_search"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="10dp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/white" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- Category tabs: stay pinned below the status bar once the header has scrolled away -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                app:tabGravity="start"
                app:tabIndicatorHeight="0dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="4dp"
                app:tabPaddingStart="4dp"
                app:tabRippleColor="@android:color/transparent" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- Solid page color behind the status bar, faded in as the header leaves, so the photo
             never shows through above the pinned tabs (height = status bar, set in code) -->
        <View
            android:id="@+id/statusBarScrim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:alpha="0"
            android:background="@color/background"
            android:outlineProvider="none"
            android:translationZ="16dp" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
