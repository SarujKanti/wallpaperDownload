<?xml version="1.0" encoding="utf-8"?>
<!-- About Wallora: centered glass dialog (background and blur set on the window in code).
     Scrolls on small screens; the buttons stay visible below the content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="22dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- App identity -->
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/wallora_logo"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Wallora.LogoTile" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:text="@string/lbl_git_repo"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAboutVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/aboutScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sources -->
            <LinearLayout style="@style/AboutCard">

                <TextView
                    style="@style/AboutCardTitle"
                    android:text="@string/about_sources_title" />

                <TextView
                    style="@style/AboutBullet"
                    android:text="@string/about_source_wallhaven" />

                <TextView
                    style="@style/AboutBullet"
                    android:text="@string/about_source_pixabay" />

                <TextView
                    style="@style/AboutBullet"
                    android:text="@string/about_source_collection" />

                <TextView
                    style="@style/AboutBullet"
                    android:text="@string/about_source_picsum" />
            </LinearLayout>

            <!-- Privacy -->
            <LinearLayout style="@style/AboutCard">

                <TextView
                    style="@style/AboutCardTitle"
                    android:text="@string/about_privacy_title" />

                <TextView
                    style="@style/AboutBullet"
                    android:text="@string/about_privacy_account" />

                <TextView
                    style="@style/AboutBullet"
                    android:text="@string/about_privacy_tracking" />

                <TextView
                    style="@style/AboutBullet"
                    android:text="@string/about_privacy_likes" />

                <TextView
                    style="@style/AboutBullet"
                    android:text="@string/about_privacy_network" />

                <TextView
                    style="@style/AboutBullet"
                    android:text="@string/about_storage" />
            </LinearLayout>

            <!-- Copyright -->
            <LinearLayout style="@style/AboutCard">

                <TextView
                    style="@style/AboutCardTitle"
                    android:text="@string/about_copyright_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/about_copyright_body"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAboutEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/contact_email"
                    android:textColor="@color/accent_purple"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/btnAboutContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_gradient_primary"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/about_contact"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnAboutClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dialog_button"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/lbl_close"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
