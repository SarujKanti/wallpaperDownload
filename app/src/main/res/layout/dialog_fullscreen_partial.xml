<?xml version="1.0" encoding="utf-8"?>
<!-- Side drawer. Runs edge to edge; the header and footer are padded clear of the
     status and navigation bars in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- Header: brand gradient with a soft diagonal sheen -->
    <FrameLayout
        android:id="@+id/drawerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_drawer_header"
        android:foreground="@drawable/bg_drawer_sheen">

        <LinearLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:elevation="4dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/wallora_logo"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Wallora.LogoTile"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/lbl_git_repo"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:text="@string/lbl_tagline"
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Menu (scrolls on short screens / landscape) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/DrawerSection"
                android:text="@string/lbl_section_browse" />

            <LinearLayout style="@style/DrawerGroup">

                <LinearLayout
                    android:id="@+id/menuExplore"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:backgroundTint="@color/menu_explore_bg"
                        android:src="@drawable/ic_wallpaper"
                        app:tint="@color/menu_explore" />

                    <TextView
                        style="@style/DrawerRowTitle"
                        android:text="@string/lbl_menu_home" />

                    <ImageView style="@style/DrawerRowChevron" />
                </LinearLayout>

                <View style="@style/DrawerDivider" />

                <LinearLayout
                    android:id="@+id/menuLiked"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:backgroundTint="@color/menu_liked_bg"
                        android:src="@drawable/ic_heart"
                        app:tint="@color/menu_liked" />

                    <TextView
                        style="@style/DrawerRowTitle"
                        android:text="@string/lbl_menu_liked" />

                    <!-- Number of liked wallpapers -->
                    <TextView
                        android:id="@+id/tvLikedCount"
                        style="@style/DrawerCountBadge" />

                    <ImageView style="@style/DrawerRowChevron" />
                </LinearLayout>

                <View style="@style/DrawerDivider" />

                <LinearLayout
                    android:id="@+id/menuDownloads"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:backgroundTint="@color/menu_downloads_bg"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/menu_downloads" />

                    <TextView
                        style="@style/DrawerRowTitle"
                        android:text="@string/lbl_menu_downloads" />

                    <ImageView style="@style/DrawerRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/DrawerSection"
                android:text="@string/lbl_section_settings" />

            <LinearLayout style="@style/DrawerGroup">

                <LinearLayout
                    android:id="@+id/menuTheme"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:backgroundTint="@color/menu_theme_bg"
                        android:src="@drawable/ic_theme"
                        app:tint="@color/menu_theme" />

                    <TextView
                        style="@style/DrawerRowTitle"
                        android:text="@string/lbl_menu_theme" />

                    <!-- Current theme, e.g. "System default" -->
                    <TextView
                        android:id="@+id/tvThemeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_value_pill"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <ImageView style="@style/DrawerRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/DrawerSection"
                android:text="@string/lbl_section_support" />

            <LinearLayout style="@style/DrawerGroup">

                <LinearLayout
                    android:id="@+id/menuShare"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:backgroundTint="@color/menu_share_bg"
                        android:src="@drawable/ic_share"
                        app:tint="@color/menu_share" />

                    <TextView
                        style="@style/DrawerRowTitle"
                        android:text="@string/lbl_menu_share" />

                    <ImageView style="@style/DrawerRowChevron" />
                </LinearLayout>

                <View style="@style/DrawerDivider" />

                <LinearLayout
                    android:id="@+id/menuReport"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:backgroundTint="@color/menu_liked_bg"
                        android:src="@drawable/ic_flag"
                        app:tint="@color/menu_liked" />

                    <TextView
                        style="@style/DrawerRowTitle"
                        android:text="@string/lbl_menu_report" />

                    <ImageView style="@style/DrawerRowChevron" />
                </LinearLayout>

                <View style="@style/DrawerDivider" />

                <LinearLayout
                    android:id="@+id/menuAbout"
                    style="@style/DrawerRow">

                    <ImageView
                        style="@style/DrawerRowIcon"
                        android:backgroundTint="@color/menu_about_bg"
                        android:src="@drawable/ic_info"
                        app:tint="@color/menu_about" />

                    <TextView
                        style="@style/DrawerRowTitle"
                        android:text="@string/lbl_menu_about" />

                    <ImageView style="@style/DrawerRowChevron" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <LinearLayout
        android:id="@+id/drawerFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_powered_by"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
