<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_drawer"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/drawerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_drawer_header"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_logo">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wallpaper"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lbl_git_repo"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/lbl_developer"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/menuExplore"
        style="@style/DrawerItem"
        android:layout_marginTop="12dp"
        android:text="@string/lbl_menu_home"
        app:drawableStartCompat="@drawable/ic_wallpaper" />

    <TextView
        android:id="@+id/menuLiked"
        style="@style/DrawerItem"
        android:text="@string/lbl_menu_liked"
        app:drawableStartCompat="@drawable/ic_heart" />

    <TextView
        android:id="@+id/menuDownloads"
        style="@style/DrawerItem"
        android:text="@string/lbl_menu_downloads"
        app:drawableStartCompat="@drawable/ic_folder" />

    <TextView
        android:id="@+id/menuTheme"
        style="@style/DrawerItem"
        app:drawableStartCompat="@drawable/ic_theme" />

    <TextView
        android:id="@+id/menuShare"
        style="@style/DrawerItem"
        android:text="@string/lbl_menu_share"
        app:drawableStartCompat="@drawable/ic_share" />

    <TextView
        android:id="@+id/menuAbout"
        style="@style/DrawerItem"
        android:text="@string/lbl_menu_about"
        app:drawableStartCompat="@drawable/ic_info" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="@string/lbl_powered_by"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="28dp"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />
</LinearLayout>
