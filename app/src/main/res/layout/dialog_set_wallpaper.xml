<?xml version="1.0" encoding="utf-8"?>
<!-- "Set wallpaper" centered glass dialog. The frosted background and blur are set on the window in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="22dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/lbl_set_as"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="@string/lbl_set_subtitle"
        android:textColor="@color/preview_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/optionHome"
        style="@style/SetOptionRow">

        <ImageView
            style="@style/SetOptionIcon"
            android:src="@drawable/ic_home" />

        <LinearLayout style="@style/SetOptionText">

            <TextView
                style="@style/SetOptionTitle"
                android:text="@string/lbl_home_screen" />

            <TextView
                style="@style/SetOptionSubtitle"
                android:text="@string/lbl_home_screen_desc" />
        </LinearLayout>

        <ImageView
            style="@style/DrawerRowChevron"
            app:tint="@color/preview_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionLock"
        style="@style/SetOptionRow">

        <ImageView
            style="@style/SetOptionIcon"
            android:src="@drawable/ic_lock" />

        <LinearLayout style="@style/SetOptionText">

            <TextView
                style="@style/SetOptionTitle"
                android:text="@string/lbl_lock_screen" />

            <TextView
                style="@style/SetOptionSubtitle"
                android:text="@string/lbl_lock_screen_desc" />
        </LinearLayout>

        <ImageView
            style="@style/DrawerRowChevron"
            app:tint="@color/preview_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionBoth"
        style="@style/SetOptionRow">

        <ImageView
            style="@style/SetOptionIcon"
            android:src="@drawable/ic_layers" />

        <LinearLayout style="@style/SetOptionText">

            <TextView
                style="@style/SetOptionTitle"
                android:text="@string/lbl_both_screens" />

            <TextView
                style="@style/SetOptionSubtitle"
                android:text="@string/lbl_both_screens_desc" />
        </LinearLayout>

        <ImageView
            style="@style/DrawerRowChevron"
            app:tint="@color/preview_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_set_cancel"
        android:gravity="center"
        android:minHeight="50dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/lbl_cancel"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
