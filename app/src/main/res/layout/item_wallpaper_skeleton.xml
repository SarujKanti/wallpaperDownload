<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder with the same shape as item_wallpaper: 4:5 card, like button,
     title and info line. A shimmer sweeps across it while wallpapers load. -->
<com.skd.wallpaper.utils.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:importantForAccessibility="noHideDescendants">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/skeletonImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_skeleton_card"
            app:layout_constraintDimensionRatio="4:5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_skeleton_circle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/skeletonTitle"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_skeleton_line"
            app:layout_constraintBottom_toTopOf="@id/skeletonMeta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.55" />

        <View
            android:id="@+id/skeletonMeta"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_skeleton_line"
            app:layout_constraintBottom_toBottomOf="@id/skeletonImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.35" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.skd.wallpaper.utils.ShimmerFrameLayout>
