<?xml version="1.0" encoding="utf-8"?>
<!-- "Choose theme" centered glass dialog. Glass background and blur are set on the window in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="22dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_set_icon"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:src="@drawable/ic_theme"
        app:tint="@color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="@string/lbl_choose_theme"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="18dp"
        android:text="@string/lbl_theme_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <include
        android:id="@+id/optionSystem"
        layout="@layout/item_theme_option" />

    <include
        android:id="@+id/optionLight"
        layout="@layout/item_theme_option" />

    <include
        android:id="@+id/optionDark"
        layout="@layout/item_theme_option" />

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_dialog_button"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/lbl_cancel"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
