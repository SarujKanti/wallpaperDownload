<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TSS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_pink</item>
        <item name="colorAccent">@color/accent_pink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="fontFamily">@font/inter_500</item>
        <item name="android:fontFamily">@font/inter_500</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Wallpaper.Dialog</item>

        <!-- 12sp body text for widgets whose text size isn't set in our layouts: dialogs and
             their lists, popup menus, snackbars, buttons, input fields. sp scales with the
             user's font size setting (nonlinearly on Android 14+). -->
        <item name="android:textAppearance">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceListItem">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceListItemSmall">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Wallora.Label</item>
        <item name="textAppearanceButton">@style/TextAppearance.Wallora.Label</item>
    </style>

    <style name="Theme.Wallpaper" parent="Base.Theme.TSS" />

    <!-- App-wide default text sizes -->
    <style name="TextAppearance.Wallora.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/inter_500</item>
        <item name="fontFamily">@font/inter_500</item>
    </style>

    <style name="TextAppearance.Wallora.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/inter_500</item>
        <item name="fontFamily">@font/inter_500</item>
    </style>

    <style name="Theme.Wallpaper.Splash" parent="Theme.Wallpaper">
        <item name="android:windowBackground">@drawable/bg_gradient_splash</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Wallpaper.Preview" parent="Theme.Wallpaper">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.Wallpaper.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Wallpaper.Dialog</item>
    </style>

    <style name="ShapeAppearance.Wallpaper.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Header photo: square top (under the status bar), rounded bottom edge -->
    <style name="ShapeAppearance.Wallora.HeroBottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
    </style>

    <!-- Rounded tile for the Wallora logo (splash screen, drawer header) -->
    <style name="ShapeAppearance.Wallora.LogoTile" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22%</item>
    </style>

    <style name="SideDrawerDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/SideDrawerAnimation</item>
    </style>

    <style name="SideDrawerAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@anim/slide_out_left</item>
    </style>

    <style name="ActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/preview_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ActionIcon">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_preview_button</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">@color/preview_text</item>
    </style>

    <!-- Side drawer rows: colored icon tile, title, and a chevron -->
    <style name="DrawerRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/bg_drawer_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="DrawerRowIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_menu_icon</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="DrawerRowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DrawerRowChevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/text_hint</item>
    </style>

    <style name="DrawerSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--    this is our toolbar theme-->
    <style name="ToolBarTheme" parent="ThemeOverlay.AppCompat.ActionBar" >
        <item name="colorControlNormal">@color/txt_title</item>
        <item name="homeAsUpIndicator">@drawable/arrow_back</item>

    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/inter_500</item>
    </style>
    <style name="textViewStyle" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/inter_500</item>

    </style>
    <style name="CustomLoader" parent="android:Theme.Holo.Dialog">

        <item name="alertDialogStyle">@style/CustomAlertDialogStyle</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:textStyle">normal</item>

    </style>
    <style name="CustomDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="CustomAlertDialogStyle">
        <item name="android:bottomBright">@color/transparent</item>
        <item name="android:bottomDark">@color/transparent</item>
        <item name="android:bottomMedium">@color/transparent</item>
        <item name="android:centerBright">@color/transparent</item>
        <item name="android:centerDark">@color/transparent</item>
        <item name="android:centerMedium">@color/transparent</item>
        <item name="android:fullBright">@color/transparent</item>
        <item name="android:fullDark">@color/transparent</item>
        <item name="android:topBright">@color/transparent</item>
        <item name="android:topDark">@color/transparent</item>
    </style>

    <style name="LoginEditText" parent="Base.Widget.AppCompat.EditText">
        <item name="android:textColor">@color/black</item>
        <!--        <item name="android:textSize">@dimen/_12ssp</item>-->
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint" tools:ignore="NewApi">@color/txt_title</item>
    </style>


</resources>



