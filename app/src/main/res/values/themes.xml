<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TSS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_pink</item>
        <item name="colorAccent">@color/accent_pink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="fontFamily">@font/inter_500</item>
        <item name="android:fontFamily">@font/inter_500</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Wallpaper.Dialog</item>
        <!-- Card ⋮ menu (android.widget.PopupMenu) as a frosted glass panel -->
        <item name="android:popupMenuStyle">@style/Widget.Wallora.PopupMenu</item>
        <item name="popupMenuStyle">@style/Widget.Wallora.PopupMenu</item>

        <!-- 12sp body text for widgets whose text size isn't set in our layouts: dialogs and
             their lists, popup menus, snackbars, buttons, input fields. sp scales with the
             user's font size setting (nonlinearly on Android 14+). -->
        <item name="android:textAppearance">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.Wallora.Body</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceListItem">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceListItemSmall">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Wallora.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Wallora.Label</item>
        <item name="textAppearanceButton">@style/TextAppearance.Wallora.Label</item>
    </style>

    <style name="Theme.Wallpaper" parent="Base.Theme.TSS" />

    <!-- App-wide default text sizes -->
    <style name="TextAppearance.Wallora.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/inter_500</item>
        <item name="fontFamily">@font/inter_500</item>
    </style>

    <style name="TextAppearance.Wallora.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/inter_500</item>
        <item name="fontFamily">@font/inter_500</item>
    </style>

    <style name="Theme.Wallpaper.Splash" parent="Theme.Wallpaper">
        <item name="android:windowBackground">@drawable/bg_gradient_splash</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Wallpaper.Preview" parent="Theme.Wallpaper">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.Wallpaper.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Wallpaper.Dialog</item>
    </style>

    <style name="ShapeAppearance.Wallpaper.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Header photo: square top (under the status bar), rounded bottom edge -->
    <style name="ShapeAppearance.Wallora.HeroBottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
    </style>

    <!-- Rounded tile for the Wallora logo (splash screen, drawer header) -->
    <style name="ShapeAppearance.Wallora.LogoTile" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22%</item>
    </style>

    <style name="SideDrawerDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/SideDrawerAnimation</item>
    </style>

    <style name="SideDrawerAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@anim/slide_out_left</item>
    </style>

    <style name="ActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/preview_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ActionIcon">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_preview_button</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">@color/preview_text</item>
    </style>

    <!-- Side drawer rows: colored icon tile, title, and a chevron -->
    <style name="DrawerRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/bg_drawer_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="DrawerRowIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/bg_menu_icon</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="DrawerRowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DrawerRowChevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/text_hint</item>
    </style>

    <style name="DrawerSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Set wallpaper glass dialog (always dark: it sits over the wallpaper preview) -->
    <!-- Rounded glass card holding a group of drawer rows -->
    <style name="DrawerGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_glass_group</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">4dp</item>
    </style>

    <!-- Hairline between rows, indented to start under the row titles -->
    <style name="DrawerDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.6dp</item>
        <item name="android:layout_marginStart">60dp</item>
        <item name="android:background">@color/glass_separator</item>
    </style>

    <style name="DrawerHeaderChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_header_chip</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="drawableTint">@color/white</item>
    </style>

    <!-- Small gradient count pill, e.g. liked wallpapers -->
    <style name="DrawerCountBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_count_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">22dp</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- About dialog sections -->
    <style name="AboutCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/bg_glass_group</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="AboutCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AboutBullet">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="drawableStartCompat">@drawable/bg_about_dot</item>
    </style>

    <style name="SetWallpaperSheet" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/SetWallpaperSheetAnimation</item>
    </style>

    <!-- Centered glass dialog that follows the app theme (light/dark), e.g. Choose theme -->
    <style name="GlassDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/SetWallpaperSheetAnimation</item>
    </style>

    <style name="SetWallpaperSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_pop_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_pop_out</item>
    </style>

    <style name="SetOptionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/bg_set_option</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="SetOptionIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/bg_set_icon</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/white</item>
    </style>

    <style name="SetOptionText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SetOptionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SetOptionSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/preview_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Wallora.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_glass_popup</item>
        <item name="android:popupElevation">12dp</item>
    </style>
</resources>
